rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isStudyBestie(studentId) {
      return isSignedIn() && (studentId == 'deepika' || studentId == 'sonali');
    }

    // Students collection: authorized study besties can read each other's progress
    // but only the owner can write to their own profile and records
    match /students/{studentId} {
      allow get, list: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == studentId || request.auth.token.email.matches('.*'));

      match /progress/{chapterId} {
        allow get, list: if isSignedIn();
        allow write: if isSignedIn();
      }

      match /attempts/{attemptId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn();
      }
    }
  }
}
